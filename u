local function checkers(p, w, h, cell, transparency, z)
    local group = new('Frame', p, {
        Name = 'CheckerboardFX',
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(-cell * 2, -cell * 2),
        Size = UDim2.fromOffset(w + cell * 5, h + cell * 5),
        ZIndex = z,
        ClipsDescendants = true,
    })
    local columns = math.ceil((w + cell * 5) / cell)
    local rows = math.ceil((h + cell * 5) / cell)
    for iy = 0, rows do
        for ix = 0, columns do
            if (ix + iy) % 2 == 0 then
                local tile = new('Frame', group, {
                    Position = UDim2.fromOffset(ix * cell, iy * cell),
                    Size = UDim2.fromOffset(cell, cell),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundTransparency = math.min(0.98, transparency + ix / math.max(1, columns) * 0.15),
                    BorderSizePixel = 0,
                    Rotation = 0,
                    ZIndex = z,
                })
                new('UIGradient', tile, {
                    Rotation = 45,
                    Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(121,226,255)),
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.55),
                        NumberSequenceKeypoint.new(1, 0.75),
                    })
                })
            end
        end
    end
    return group
end

