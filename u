local function playButtonClickSound()
    if not settings.SFX then return end
    if not buttonClickSound or not buttonClickSound.Parent then return end
    buttonClickSound:Stop()
    buttonClickSound.TimePosition = 0
    buttonClickSound:Play()
end

local function new(class, parent, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    if obj:IsA('GuiButton') then
        obj.Activated:Connect(function()
            if obj:GetAttribute('SAE_SFXToggle') then return end
            playButtonClickSound()
        end)
    end
    return obj
end

local function corner(p, r)
    return new('UICorner', p, { CornerRadius = UDim.new(0, r) })
end

local function stroke(p, width, forText)
    return new('UIStroke', p, {
        Thickness = width,
        Color = C.border,
        ApplyStrokeMode = forText and Enum.ApplyStrokeMode.Contextual or Enum.ApplyStrokeMode.Border,
        Transparency = forText and 0.12 or 0,
    })
end

local function gradient(p, colors)
    return new('UIGradient', p, {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, colors[1]),
            ColorSequenceKeypoint.new(0.58, colors[2]),
            ColorSequenceKeypoint.new(1, colors[3] or colors[2]),
        })
    })
end

local function label(p, value, x, y, w, h, fontSize, opts)
    opts = opts or {}
    local v = new('TextLabel', p, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(w, h),
        Text = value,
