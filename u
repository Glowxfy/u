        TextTruncate = opts.truncate or Enum.TextTruncate.AtEnd,
        RichText = opts.rich == true,
        ZIndex = opts.z or 12,
    })
    if opts.outline ~= false then stroke(v, opts.stroke or 1.7, true) end
    return v
end

