    corner(face, opts.nav and 10 or 8)
    local grad = gradient(face, { pal[1], pal[2], pal[2] })
    if opts.checkers ~= false then checkers(face, w, h, 14, 0.965, z + 2) end

    local faceBorder = stroke(face, 1.45)
    faceBorder.Name = 'PaletteStroke'
    faceBorder.Color = Color3.fromRGB(57, 77, 109)

    local gloss = new('Frame', face, {
        Position = UDim2.fromOffset(1, 1),
        Size = UDim2.new(1, -2, 0.42, 0),
        BackgroundColor3 = C.white,
        BackgroundTransparency = 0.965,
        BorderSizePixel = 0,
        ZIndex = z + 3,
    })
    corner(gloss, opts.nav and 10 or 8)
    new('UIGradient', gloss, {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(1, 1),
        })
    })

    local activeRail
    if opts.nav then
        activeRail = new('Frame', face, {
            Name = 'SelectedRail',
            Position = UDim2.fromOffset(7, 10),
            Size = UDim2.fromOffset(5, h - 24),
            BackgroundColor3 = Color3.fromRGB(173, 244, 255),
            BorderSizePixel = 0,
            ZIndex = z + 5,
            Visible = false,
        })
        corner(activeRail, 3)
    end

    local iconAccent
    if opts.nav then
        iconAccent = new('TextLabel', face, {
            Name = 'TabGlyph',
            Position = UDim2.fromOffset(12, 10),
            Size = UDim2.fromOffset(28, 21),
            Text = name == 'HOME' and '⌂' or name == 'TELEPORT' and '➤' or name == 'EXPLOITS' and '⚡' or name == 'AUTO STEAL' and '◈' or name == 'AUTO FARM' and '◇' or name == 'WINDOWS' and '▣' or name == 'SETTINGS' and '⚙' or name == 'PREFERENCES' and '◉' or '▤',
            Font = Enum.Font.GothamBold,
            TextSize = 19,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextColor3 = C.muted,
            BackgroundTransparency = 1,
            ZIndex = z + 4,
        })
    end

    local shine
    if opts.shimmer then
        shine = new('Frame', face, {
            Name = 'Shimmer',
            Position = UDim2.fromOffset(-40, -34),
            Size = UDim2.fromOffset(30, h + 72),
            BackgroundColor3 = C.white,
            BackgroundTransparency = 0.82,
            BorderSizePixel = 0,
            Rotation = 17,
            ZIndex = z + 4,
            Visible = false,
        })
        table.insert(buttonsWithShine, { item = shine, width = w, offset = #buttonsWithShine / 2.7 })
    end

    local caption = label(face, name, opts.nav and 49 or 0, 0, opts.nav and (w - 55) or w, h - 5, opts.nav and 13 or (opts.fontSize or 15), {
        align = opts.nav and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
        z = z + 5,
        font = opts.font or Enum.Font.GothamMedium,
    })

    if opts.nav then
        caption.Position = UDim2.fromOffset(50, 4)
        caption.Size = UDim2.fromOffset(w - 57, 20)
        local subtitles = {
            HOME = 'Your overview', TELEPORT = 'Waypoints & routes',
            EXPLOITS = 'Tools & utilities', ['AUTO STEAL'] = 'Egg automation',
            ['AUTO FARM'] = 'Coming soon', WINDOWS = 'Live information',
            SETTINGS = 'Features & toggles', PREFERENCES = 'Appearance',
            CONFIGS = 'Save your profiles',
        }
        label(face, subtitles[name] or 'IXURT module', 50, 22, w - 58, 15, 10, {
            z = z + 5, color = C.muted, outline = false, font = Enum.Font.Gotham,
        })
    end

    local activeTween
    local function animate(value, duration)
        if activeTween then activeTween:Cancel() end
        if not settings.ButtonAnimations then sizeScale.Scale = 1 return end
        activeTween = TS:Create(sizeScale, TweenInfo.new(duration or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = value })
        activeTween:Play()
    end

    face.MouseEnter:Connect(function()
        animate(1.03)
        if settings.ButtonAnimations then TS:Create(faceBorder, TweenInfo.new(0.16, Enum.EasingStyle.Quad), { Transparency = 0 }):Play() end
    end)
    face.MouseLeave:Connect(function()
        animate(1)
        if settings.ButtonAnimations then TS:Create(faceBorder, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Transparency = 0.08 }):Play() end
    end)
    face.MouseButton1Down:Connect(function() animate(0.96, 0.08) end)
    face.MouseButton1Up:Connect(function() animate(1.018) end)
