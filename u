            faceBorder.Color = Color3.fromRGB(54, 67, 92)
        else
            setPalette({ gradient = grad, bottom = shadow, face = face }, value)
        end
        if activeRail then activeRail.Visible = value == 'cyan' end
        if iconAccent then iconAccent.TextColor3 = value == 'cyan' and C.cyanHi or C.muted end
        caption.TextColor3 = value == 'cyan' and C.white or (opts.nav and Color3.fromRGB(191, 198, 211) or C.white)
    end

    palette(theme)

    return {
        face = face,
        holder = holder,
        caption = caption,
        gradient = grad,
        bottom = shadow,
        palette = palette,
    }
end

